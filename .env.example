# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This example file is the
# only env file that is allowed into git, so keep it free of real credentials.

# --- Jira -------------------------------------------------------------------
# Base URL of the Jira instance, no trailing slash.
JIRA_BASE_URL=https://your-org.atlassian.net
# The account the agents file and read tickets as.
JIRA_USER_EMAIL=you@example.com
# Jira API token. Create at id.atlassian.com > Security > API tokens.
JIRA_API_TOKEN=replace-me
# Project key that test plans and defects are filed under.
JIRA_PROJECT=SSPLAN

# --- Target application -----------------------------------------------------
# The deployed frontend the suites run against.
LIVE_UI_URL=https://dev.salesplanning.ingka.com
