{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfluenceWriterInput",
  "type": "object",
  "required": ["runId", "ticketSummaries"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "confluenceBaseUrl": {
      "type": "string",
      "default": "https://confluence.build.ingka.ikea.com/"
    },
    "spaceKey": {
      "type": "string",
      "default": "SSP"
    },
    "pageId": {
      "type": "string",
      "default": "1353804850"
    },
    "pageTitle": {
      "type": "string",
      "default": "AI QA Summary"
    },
    "jiraBaseUrl": {
      "type": "string",
      "default": "https://jira.digital.ingka.com",
      "description": "Base Jira URL used to link each Jira ticket cell in the Confluence table."
    },
    "ticketSummaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "jiraTicket",
          "lastTestRunAt",
          "jiraTitle",
          "testsPassing",
          "testsFailing",
          "testsVlocked",
          "bugsFound"
        ],
        "properties": {
          "jiraTicket": { "type": "string", "minLength": 1 },
          "lastTestRunAt": {
            "type": "string",
            "minLength": 1,
            "description": "Latest ticket-scoped test execution date for this story (YYYY-MM-DD)."
          },
          "jiraTitle": { "type": "string", "minLength": 1 },
          "isSubtask": {
            "type": "boolean",
            "description": "True when the Jira ticket is a subtask."
          },
          "parentKey": {
            "type": "string",
            "description": "Parent ticket key when isSubtask is true, e.g. SSPLAN-623."
          },
          "testsPassing": { "type": "number", "minimum": 0 },
          "testsFailing": { "type": "number", "minimum": 0 },
          "testsVlocked": {
            "type": "number",
            "minimum": 0,
            "description": "Blocked/skipped/todo test count written to the 'tests blocked' table column."
          },
          "bugsFound": { "type": "number", "minimum": 0 },
          "testDetails": {
            "type": "array",
            "description": "Individual test results used to populate the expand macro inside each row.",
            "items": {
              "type": "object",
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["passed", "failed", "blocked"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "dryRun": { "type": "boolean" }
  },
  "additionalProperties": false
}
